{
    "name": "in-memoriam-pascal",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "predev": "npm run build:engine",
        "dev": "vite",
        "prebuild": "npm run build:engine",
        "build": "tsc -b && vite build",
        "build:engine": "node scripts/build-engine.mjs",
        "lint": "eslint src tests",
        "audit": "node scripts/audit.mjs",
        "preview": "vite preview",
        "test": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@fontsource/press-start-2p": "^5.3.0",
        "@fontsource/vt323": "^5.3.0",
        "@monaco-editor/react": "^4.7.0",
        "i18next": "^26.5.4",
        "monaco-editor": "^0.57.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-i18next": "^17.1.0",
        "react-router-dom": "^7.18.4",
        "zustand": "^5.0.3"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.1",
        "@eslint/js": "^9.21.0",
        "@playwright/test": "^1.58.2",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.2.0",
        "@types/node": "^25.3.0",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@vitejs/plugin-react": "^4.3.4",
        "eslint": "^9.21.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^16.0.0",
        "jison": "^0.4.18",
        "jsdom": "^30.1.3",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.26.0",
        "vite": "^6.4.4",
        "vite-plugin-pwa": "^0.21.1",
        "vitest": "^4.1.12"
    },
    "overrides": {
        "dompurify": "^3.4.17",
        "underscore": "^1.13.8"
    },
    "engines": {
        "node": ">=22.22.2"
