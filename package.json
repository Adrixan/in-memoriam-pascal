        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "jison": "^0.4.18",
        "jsdom": "^30.1.3",
        "tailwindcss": "^4.3.3",
        "terser": "^5.51.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vite-plugin-pwa": "^2.0.0",
