        "i18next": "^26.5.11",
        "monaco-editor": "^0.57.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^17.1.9",
        "react-router-dom": "^7.18.4",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
